# Copy this file to .env and fill in values for local development.
# In production (Render, etc.) set these as real environment variables
# instead -- never commit a real .env file (it's already in .gitignore).

# --- Repo / indexing ---
REPO_SENTINEL_REPO_PATH=./data/fastapi
REPO_SENTINEL_INDEX_SUBDIR=fastapi
REPO_SENTINEL_INDEX_DIR=./data/index
REPO_SENTINEL_AUTO_SUMMARIZE=false
REPO_SENTINEL_EVAL_SET=./src/eval/eval_set.json

# Embedding model. Default (jina-embeddings-v2-base-code) is code-specific
# and gives better retrieval, but needs more RAM than fits in Render's
# free-tier 512MB limit -- render.yaml overrides this to a smaller model
# (sentence-transformers/all-MiniLM-L6-v2) for the deployed version. If
# you change this on an existing index, you MUST delete data/index and
# let it rebuild -- different models produce different-dimension vectors.
REPO_SENTINEL_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code

# --- Generation backend: "ollama" (local dev) or "groq" (deployed) ---
REPO_SENTINEL_LLM_BACKEND=ollama

# --- Ollama (only used when LLM_BACKEND=ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Groq (only used when LLM_BACKEND=groq; get a free key at console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- API security ---
# Leave REPO_SENTINEL_API_KEY unset for local dev (no auth required).
# Set it before deploying publicly -- /query and /reindex will then
# require a matching `X-API-Key` header.
REPO_SENTINEL_API_KEY=
REPO_SENTINEL_RATE_LIMIT_PER_MINUTE=20

# --- Logging ---
REPO_SENTINEL_LOG_LEVEL=INFO
